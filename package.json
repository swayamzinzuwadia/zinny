{
  "name": "zinny",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "gen": "tsx scripts/gen-registry.ts",
    "predev": "npm run gen",
    "dev": "node scripts/next.mjs dev",
    "prebuild": "npm run gen",
    "build": "next build",
    "start": "node scripts/next.mjs start",
    "lint": "eslint",
    "pretypecheck": "npm run gen",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run gen",
    "test": "vitest run",
    "db:push": "tsx scripts/db-push.ts",
    "db:reset": "tsx scripts/db-push.ts --reset",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "predb:seed": "npm run gen",
    "db:seed": "tsx --tsconfig tsconfig.scripts.json --require ./scripts/server-only-stub.cjs src/db/seed.ts",
    "agent:setup": "tsx --tsconfig tsconfig.scripts.json --require ./scripts/server-only-stub.cjs scripts/agent-setup.ts",
    "check:ownership": "tsx scripts/check-ownership.ts"
  },
  "dependencies": {
    "@expo-google-fonts/lexend": "^0.4.1",
    "@expo-google-fonts/libre-baskerville": "^0.4.3",
    "@fontsource-variable/lexend": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "next": "15.5.28",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-is": "19.1.0",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
