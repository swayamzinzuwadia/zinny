# Owner role: runs migrations, sign-in lookups and the Zinny team panel. Bypasses row-level security.
DATABASE_URL_OWNER=postgres://zinny_owner:CHANGE_ME@localhost:5432/zinny_dev
# App role: everything a university user does. Row-level security always applies.
# Create it once with: CREATE ROLE zinny_app LOGIN PASSWORD '...';
DATABASE_URL=postgres://zinny_app:CHANGE_ME@localhost:5432/zinny_dev

# Payments (step 3). Leave empty to use the built-in mock gateway.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
